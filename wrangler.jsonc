{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poknik-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
