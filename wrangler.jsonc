{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poknik-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PAYMENT_ENVIRONMENT": "test",
    "LIVE_PAYMENTS_ENABLED": "false"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "env": {
    "production": {
      "name": "poknik-hub-live",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "PAYMENT_ENVIRONMENT": "live",
        "LIVE_PAYMENTS_ENABLED": "false"
      },
      "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB"
        }
      ]
    }
  }
}
